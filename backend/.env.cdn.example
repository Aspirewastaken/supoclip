# SupoClip CDN Configuration Examples
# Copy the section for your chosen CDN provider to your .env file

# ==============================================================================
# GENERAL CDN SETTINGS (Required for all providers)
# ==============================================================================

# Enable CDN integration (set to true to activate)
CDN_ENABLED=false

# CDN provider: cloudfront, r2, or bunny
CDN_PROVIDER=cloudfront

# CDN base URL (your distribution/pull zone domain)
CDN_BASE_URL=https://d123456789.cloudfront.net


# ==============================================================================
# AWS CLOUDFRONT CONFIGURATION
# ==============================================================================
# Use this if CDN_PROVIDER=cloudfront

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# S3 Backend
AWS_S3_BUCKET=supoclip-clips

# CloudFront Distribution
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
CDN_BASE_URL=https://d123456789.cloudfront.net

# CloudFront Signed URLs (Optional - for private content)
CLOUDFRONT_KEY_ID=your_cloudfront_key_pair_id
CLOUDFRONT_PRIVATE_KEY_PATH=/path/to/cloudfront_private_key.pem


# ==============================================================================
# CLOUDFLARE R2 CONFIGURATION
# ==============================================================================
# Use this if CDN_PROVIDER=r2

# Cloudflare Account
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# R2 Credentials
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=supoclip-clips

# R2 Public URL (custom domain or R2.dev URL)
R2_PUBLIC_URL=https://clips.yourdomain.com
# OR use R2.dev domain:
# R2_PUBLIC_URL=https://supoclip-clips.your-account.r2.cloudflarestorage.com

# CDN Base URL (same as R2_PUBLIC_URL)
CDN_BASE_URL=https://clips.yourdomain.com

# Cloudflare Cache Purging (Optional - requires Cloudflare CDN in front of R2)
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_with_cache_purge_permission


# ==============================================================================
# BUNNY CDN CONFIGURATION
# ==============================================================================
# Use this if CDN_PROVIDER=bunny

# Bunny Storage
BUNNY_STORAGE_ZONE_NAME=supoclip-clips
BUNNY_STORAGE_API_KEY=your_bunny_storage_api_key

# Storage Region (de=Europe, ny=New York, la=Los Angeles, sg=Singapore, syd=Sydney)
BUNNY_STORAGE_REGION=de

# Bunny Pull Zone
BUNNY_PULL_ZONE_ID=12345
CDN_BASE_URL=https://supoclip.b-cdn.net
# OR custom domain:
# CDN_BASE_URL=https://clips.yourdomain.com

# Bunny API (for cache purging)
BUNNY_CDN_API_KEY=your_bunny_account_api_key


# ==============================================================================
# QUICK START EXAMPLES
# ==============================================================================

# Example 1: AWS CloudFront (Production-ready)
# CDN_ENABLED=true
# CDN_PROVIDER=cloudfront
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=supoclip-clips
# CLOUDFRONT_DISTRIBUTION_ID=E2QWRTYUIOPAS
# CDN_BASE_URL=https://d111111abcdef8.cloudfront.net

# Example 2: Cloudflare R2 (Cost-effective)
# CDN_ENABLED=true
# CDN_PROVIDER=r2
# CLOUDFLARE_ACCOUNT_ID=abc123def456
# R2_ACCESS_KEY_ID=1234567890abcdef
# R2_SECRET_ACCESS_KEY=fedcba0987654321
# R2_BUCKET_NAME=supoclip-clips
# R2_PUBLIC_URL=https://clips.yourdomain.com
# CDN_BASE_URL=https://clips.yourdomain.com

# Example 3: Bunny CDN (Best price/performance)
# CDN_ENABLED=true
# CDN_PROVIDER=bunny
# BUNNY_STORAGE_ZONE_NAME=supoclip-clips
# BUNNY_STORAGE_API_KEY=12345678-90ab-cdef-1234-567890abcdef
# BUNNY_STORAGE_REGION=de
# BUNNY_PULL_ZONE_ID=123456
# BUNNY_CDN_API_KEY=abcdef12-3456-7890-abcd-ef1234567890
# CDN_BASE_URL=https://supoclip.b-cdn.net


# ==============================================================================
# ADDITIONAL CONFIGURATION
# ==============================================================================

# Existing SupoClip configuration (from your main .env)
# ASSEMBLY_AI_API_KEY=your_assembly_ai_key
# LLM_MODEL=google-gla:gemini-2.5-flash-lite
# GOOGLE_API_KEY=your_google_api_key
# DATABASE_URL=postgresql://user:password@localhost:5432/supoclip
# TEMP_DIR=temp
# REDIS_HOST=localhost
# REDIS_PORT=6379


# ==============================================================================
# INSTALLATION NOTES
# ==============================================================================
#
# 1. Choose ONE CDN provider section above
# 2. Copy the relevant variables to your main .env file
# 3. Fill in your actual credentials and URLs
# 4. Set CDN_ENABLED=true
# 5. Install required dependencies:
#    - For CloudFront/R2: uv add boto3
#    - For cache purging: uv add aiohttp
#
# 6. Test your configuration:
#    python -c "from backend.src.storage.cdn import get_cdn_provider; p = get_cdn_provider(); print(p)"
#
# 7. Process a test video and verify CDN upload in logs
#
# For detailed setup instructions, see: backend/CDN_SETUP_GUIDE.md
#
