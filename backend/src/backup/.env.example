# SupoClip Backup System Configuration
# Copy this file to backend/.env and configure as needed

# ============================================================================
# BACKUP STORAGE
# ============================================================================

# Storage backend: 'local', 's3', or 'b2'
BACKUP_STORAGE_BACKEND=local

# Local backup directory
BACKUP_DIR=/var/backups/supoclip

# ============================================================================
# S3 / BACKBLAZE B2 CONFIGURATION
# ============================================================================

# S3 bucket name (required for s3 and b2 backends)
BACKUP_S3_BUCKET=my-supoclip-backups

# S3 region (for AWS S3)
BACKUP_S3_REGION=us-east-1

# S3 endpoint (optional, required for B2 or custom S3-compatible storage)
# For Backblaze B2: https://s3.us-west-004.backblazeb2.com
# BACKUP_S3_ENDPOINT=

# S3 credentials
# For AWS S3: Use IAM access key
# For B2: Use keyID as access key, applicationKey as secret key
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ============================================================================
# BACKUP RETENTION
# ============================================================================

# How long to keep backups (in days)
BACKUP_RETENTION_DAYS=30

# Enable compression (recommended)
BACKUP_COMPRESSION=true

# Enable encryption (requires encryption key)
BACKUP_ENCRYPTION=false
BACKUP_ENCRYPTION_KEY=

# ============================================================================
# INCREMENTAL BACKUPS
# ============================================================================

# Enable incremental backups (recommended)
BACKUP_INCREMENTAL=true

# How often to perform full backups (in days)
# Incremental backups will be used between full backups
BACKUP_FULL_INTERVAL_DAYS=7

# ============================================================================
# BACKUP SCHEDULE
# ============================================================================

# Daily backup time (24-hour format: HH:MM)
BACKUP_DAILY_TIME=02:00

# Weekly backup day (0=Monday, 1=Tuesday, ..., 6=Sunday)
BACKUP_WEEKLY_DAY=0

# ============================================================================
# VERIFICATION
# ============================================================================

# Verify backups after creation
BACKUP_VERIFY=true

# ============================================================================
# NOTIFICATIONS
# ============================================================================

# Email notification for backup status (optional)
BACKUP_NOTIFICATION_EMAIL=

# Webhook URL for notifications (optional)
# Supports Slack, Discord, or custom webhooks
# Example Slack: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
BACKUP_NOTIFICATION_WEBHOOK=

# ============================================================================
# SOURCE DIRECTORIES (defaults from main config)
# ============================================================================

# These are usually set in the main .env file
# Override here only if needed

# Temporary directory for uploads and processing
# TEMP_DIR=/tmp

# Database connection string
# DATABASE_URL=postgresql+asyncpg://supoclip:supoclip_password@localhost:5432/supoclip
