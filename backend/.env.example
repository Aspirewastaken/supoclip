# The model size of OpenAI Whisper (see https://github.com/openai/whisper#available-models-and-languages)
WHISPER_MODEL_SIZE=medium

# LLM Providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# OpenRouter (for AI Title Generation - multi-LLM access)
OPENROUTER_API_KEY=
OPENROUTER_REFERER=http://localhost:3000

# The AI Model to use throughout the app
LLM=

# Good for speed optimizations
COMPOSE_BAKE=true

# DB
POSTGRES_DB= supoclip
POSTGRES_USER= supoclip
POSTGRES_PASSWORD= supoclip_password

ASSEMBLY_AI_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# ============================================================================
# Social Media Integrations
# ============================================================================

# TikTok Integration (https://developers.tiktok.com/)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://yourdomain.com/api/social/callback/tiktok

# Instagram Integration (https://developers.facebook.com/)
# Note: Requires Facebook Business account and Instagram Business/Creator account
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://yourdomain.com/api/social/callback/instagram

# YouTube Shorts Integration (https://console.cloud.google.com/)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://yourdomain.com/api/social/callback/youtube

# Twitter/X Integration (https://developer.twitter.com/)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=https://yourdomain.com/api/social/callback/twitter
