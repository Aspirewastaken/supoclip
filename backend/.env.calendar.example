# Calendar Integration Environment Variables
# Copy this file to .env and fill in your values

# Google Calendar OAuth (Optional - Only needed if supporting Google Calendar)
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Database (Required)
DATABASE_URL=postgresql://postgres:password@localhost:5432/supoclip

# API Configuration
API_URL=http://localhost:8000
TEMP_DIR=temp

# Existing SupoClip Configuration
ASSEMBLY_AI_API_KEY=your_assembly_ai_key
LLM_MODEL=google-gla:gemini-2.5-flash-lite
GOOGLE_API_KEY=your_google_api_key  # For Gemini LLM, different from calendar OAuth

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Security (Production)
# ENCRYPTION_KEY=generate_with_fernet_generate_key()  # For encrypting passwords

# Notes:
# - Google Calendar requires OAuth setup in Google Cloud Console
# - iCloud Calendar requires users to generate app-specific passwords
# - CalDAV works with any CalDAV-compatible server (no setup needed)
