<!DOCTYPE html>
<html>
<head>
<style>
body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
  color: #333;
}
.alert {
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 15px;
  margin: 10px 0;
}
.alert.critical {
  border-left: 4px solid #d9534f;
  background: #f9e6e6;
}
.alert.warning {
  border-left: 4px solid #f0ad4e;
  background: #fcf8e3;
}
.alert-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 10px;
}
.alert-details {
  margin: 5px 0;
}
.label {
  display: inline-block;
  padding: 2px 6px;
  background: #eee;
  border-radius: 3px;
  margin: 2px;
  font-size: 12px;
}
</style>
</head>
<body>
<h2>SupoClip Alert Notification</h2>
{{ range .Alerts }}
<div class="alert {{ .Labels.severity }}">
  <div class="alert-title">{{ .Annotations.summary }}</div>
  <div class="alert-details">
    <strong>Description:</strong> {{ .Annotations.description }}
  </div>
  <div class="alert-details">
    <strong>Severity:</strong> <span class="label">{{ .Labels.severity }}</span>
  </div>
  <div class="alert-details">
    <strong>Component:</strong> <span class="label">{{ .Labels.component }}</span>
  </div>
  <div class="alert-details">
    <strong>Time:</strong> {{ .StartsAt.Format "2006-01-02 15:04:05 MST" }}
  </div>
  {{ if .Annotations.dashboard }}
  <div class="alert-details">
    <a href="{{ .Annotations.dashboard }}" style="color: #007bff;">View Dashboard</a>
  </div>
  {{ end }}
</div>
{{ end }}
</body>
</html>
{{ end }}
