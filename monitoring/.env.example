# Monitoring Configuration Environment Variables
# Copy this file to .env and fill in your values

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# PagerDuty Integration
# Get these from your PagerDuty service integration settings
PAGERDUTY_SERVICE_KEY=
PAGERDUTY_ROUTING_KEY=

# Slack Integration
# Create a webhook URL at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Email Notifications
# For Gmail, use app-specific password: https://support.google.com/accounts/answer/185833
SMTP_USERNAME=
SMTP_PASSWORD=
DATABASE_TEAM_EMAIL=database-team@supoclip.com
BACKEND_TEAM_EMAIL=backend-team@supoclip.com

# Alert Thresholds (optional - defaults in alerting rules)
# ALERT_ERROR_RATE_THRESHOLD=0.05
# ALERT_MEMORY_THRESHOLD=85
# ALERT_DISK_THRESHOLD=90
# ALERT_CPU_THRESHOLD=80
